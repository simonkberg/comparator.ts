{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
    "config:js-lib",
    ":maintainLockFilesWeekly",
    ":automergeMinor",
    ":automergeDigest",
  ],
  pinDigest: {
    automerge: true,
  },
  postUpdateOptions: ["pnpmDedupe"],
  packageRules: [
    {
      // Changesets releases the CLI, its changelog generators and the GitHub
      // action in lockstep, and their majors need migrating together.
      groupName: "changesets",
      matchPackageNames: ["@changesets/**", "changesets/action"],
    },
    {
      // Oxlint, its type-aware backend and oxfmt share a release train, and
      // oxlint-tsgolint is additionally tied to a TypeScript version.
      groupName: "oxc",
      matchPackageNames: ["oxlint", "oxlint-tsgolint", "oxfmt"],
    },
    {
      // tools/typedoc exists only to hold TypeDoc on TypeScript 6, which is
      // the newest major its peer range accepts and the newest it can load at
      // all — TypeScript 7 crashes it on startup and breaks `pnpm build:docs`.
      // Patch updates within 6.0.x are still welcome. This does not constrain
      // the root workspace, which tracks TypeScript 7.
      matchFileNames: ["tools/typedoc/package.json"],
      matchPackageNames: ["typescript"],
      allowedVersions: "6.0.x",
    },
  ],
}
