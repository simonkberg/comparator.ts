{
  "name": "comparator.ts",
  "version": "1.0.4",
  "description": "A TypeScript library for comparing values",
  "homepage": "https://github.com/simonkberg/comparator.ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonkberg/comparator.ts.git"
  },
  "license": "MIT",
  "author": "Simon Kjellberg <simon.kjellberg@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "main": "dist/index.cjs",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm build:ts && pnpm build:docs",
    "build:docs": "typedoc",
    "build:ts": "tsdown",
    "lint": "pnpm lint:eslint && pnpm lint:prettier",
    "lint:eslint": "eslint --max-warnings=0 .",
    "lint:eslint:fix": "eslint --max-warnings=0 --fix .",
    "lint:fix": "pnpm lint:eslint:fix && pnpm lint:prettier:fix",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "prepare": "husky",
    "prerelease": "pnpm build",
    "release": "changeset publish",
    "test": "tsc --noEmit && tsdown && node run-tests.js",
    "test:coverage": "node run-tests.js --coverage"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@eslint/js": "10.0.1",
    "@tsconfig/node22": "22.0.6",
    "@tsconfig/recommended": "1.0.13",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "22.20.1",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-tsdoc": "0.5.2",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-jsdoc": "1.8.1",
    "publint": "0.3.24",
    "tsdown": "0.22.14",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
